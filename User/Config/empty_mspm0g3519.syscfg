GPIOA_BOARD.associatedPins[5].pin.$assign  = "PA31";

GPIOA_BOARD.associatedPins[6].$name        = "HX711_SCK";
GPIOA_BOARD.associatedPins[6].assignedPin  = "7";
GPIOA_BOARD.associatedPins[6].initialValue = "CLEARED";
GPIOA_BOARD.associatedPins[6].pin.$assign  = "PA7";

GPIOA_BOARD.associatedPins[7].$name        = "BUZZER";
GPIOA_BOARD.associatedPins[7].assignedPin  = "15";
GPIOA_BOARD.associatedPins[7].initialValue = "SET";
GPIOA_BOARD.associatedPins[7].pin.$assign  = "PA15";
