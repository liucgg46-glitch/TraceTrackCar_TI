GPIOB_BOARD.associatedPins[2].$name            = "USER_KEY";
GPIOB_BOARD.associatedPins[2].assignedPin      = "31";
GPIOB_BOARD.associatedPins[2].direction        = "INPUT";
GPIOB_BOARD.associatedPins[2].internalResistor = "PULL_UP";
GPIOB_BOARD.associatedPins[2].pin.$assign      = "PB31";

GPIOB_BOARD.associatedPins[3].$name        = "MOTOR_FL_IN1";
GPIOB_BOARD.associatedPins[3].assignedPin  = "6";
GPIOB_BOARD.associatedPins[3].initialValue = "CLEARED";
GPIOB_BOARD.associatedPins[3].pin.$assign  = "PB6";

GPIOB_BOARD.associatedPins[4].$name        = "MOTOR_FL_IN2";
GPIOB_BOARD.associatedPins[4].assignedPin  = "7";
GPIOB_BOARD.associatedPins[4].initialValue = "CLEARED";
GPIOB_BOARD.associatedPins[4].pin.$assign  = "PB7";

GPIOB_BOARD.associatedPins[5].$name        = "MOTOR_FR_IN1";
GPIOB_BOARD.associatedPins[5].assignedPin  = "8";
GPIOB_BOARD.associatedPins[5].initialValue = "CLEARED";
