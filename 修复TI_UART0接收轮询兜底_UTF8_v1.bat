powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "$b=[IO.File]::ReadAllText($env:PATCH_B64); $b=[Text.RegularExpressions.Regex]::Replace($b,'\s',''); [IO.File]::WriteAllBytes($env:PATCH_PS1,[Convert]::FromBase64String($b))"

