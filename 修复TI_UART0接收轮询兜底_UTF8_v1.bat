set "RC=%ERRORLEVEL%"
type "%PATCH_LOG%"

if "%RC%"=="0" (
    del /q "%PATCH_B64%" "%PATCH_PS1%" "%PATCH_LOG%" >nul 2>nul
    echo.
    echo [OK] TI UART0 RX polling fallback fix completed successfully.
    popd
    pause
    exit /b 0
)

echo.
echo [FAILED] Error code: %RC%
echo Log: %PATCH_LOG%
echo Base64 file: %PATCH_B64%
echo PowerShell file: %PATCH_PS1%
echo bsp_uart.c was restored from backup when writing had started.
popd
pause
exit /b %RC%
