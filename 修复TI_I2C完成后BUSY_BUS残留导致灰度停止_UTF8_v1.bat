powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "$b=[IO.File]::ReadAllText($env:PATCH_B64); $b=[Text.RegularExpressions.Regex]::Replace($b,'\s',''); [IO.File]::WriteAllBytes($env:PATCH_PS1,[Convert]::FromBase64String($b))"

if errorlevel 1 (
    echo.
    echo [FAILED] Cannot decode PowerShell script.
    echo Base64 file: %PATCH_B64%
    popd
    pause
    exit /b 1
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%PATCH_PS1%" >"%PATCH_LOG%" 2>&1
set "RC=%ERRORLEVEL%"
type "%PATCH_LOG%"

if "%RC%"=="0" (
    del /q "%PATCH_B64%" "%PATCH_PS1%" "%PATCH_LOG%" >nul 2>nul
    echo.
    echo [OK] I2C BUSY_BUS completion fix completed successfully.
    popd
    pause
    exit /b 0
)

echo.
echo [FAILED] Error code: %RC%
echo Log: %PATCH_LOG%
echo Base64 file: %PATCH_B64%
echo PowerShell file: %PATCH_PS1%
echo bsp_i2c.c is restored automatically if writing had started.
popd
pause
exit /b %RC%
